{
	"name": "tardis",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.12.1",
	"engines": {
		"node": ">=24.0.0"
	},
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"start:dev": "vite dev --port 3000",
		"generate-routes": "tsr generate",
