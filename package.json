{
	"name": "tardis",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.12.1",
	"engines": {
		"node": ">=24.0.0"
	},
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"dev": "node scripts/prepare-api-docs.mjs && vite dev --port 3006 --strictPort",
		"start:dev": "pnpm dev",
		"generate-routes": "tsr generate",
		"build": "node scripts/prepare-api-docs.mjs && vite build",
		"preview": "vite preview",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"lint": "biome lint .",
		"check": "biome check .",
		"check:write": "biome check --write .",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:check": "drizzle-kit check",
		"test:db": "node --env-file-if-exists=.env.local ./node_modules/vitest/vitest.mjs run test/integration/domain.integration.test.ts",
		"test:e2e": "playwright test"
	},
	"dependencies": {
		"@code-x/lago": "^0.9.1",
		"@js-temporal/polyfill": "^0.5.1",
		"@neondatabase/serverless": "^1.1.0",
		"@tanstack/react-router": "1.170.41",
		"@tanstack/react-start": "1.168.60",
		"better-auth": "^1.7.6",
		"clsx": "^2.1.1",
		"drizzle-orm": "^0.45.3",
		"lucide-react": "^1.49.0",
		"maplibre-gl": "^6.11.2",
		"nitro": "3.0.260610-beta",
		"pg": "^8.23.0",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"rrule": "^2.8.1",
		"swagger-ui-dist": "^5.33.0",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@apidevtools/swagger-parser": "^13.0.0",
		"@biomejs/biome": "2.4.5",
		"@playwright/test": "1.62.1",
		"@tanstack/router-cli": "^1.132.0",
		"@testing-library/react": "16.3.3",
		"@testing-library/user-event": "14.6.6",
		"@types/node": "^22.10.2",
		"@types/pg": "^8.23.1",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.0.1",
		"dotenv": "^17.4.2",
		"drizzle-kit": "^0.31.10",
		"jsdom": "30.0.1",
		"typescript": "^6.0.2",
		"vite": "^8.0.0",
		"vitest": "^5.0.0"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild",
			"lightningcss"
		]
	}
}
