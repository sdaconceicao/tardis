		"@tanstack/react-router": "latest",
		"@tanstack/react-start": "latest",
		"drizzle-orm": "^0.45.2",
		"lucide-react": "^1.43.0",
		"maplibre-gl": "^6.8.0",
		"nitro": "3.0.260610-beta",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"zod": "^4.5.4"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.5",
		"@tanstack/router-cli": "^1.132.0",
		"@types/node": "^22.10.2",
