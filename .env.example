# Use the pooled Neon connection string for deployed environments.
DATABASE_URL=postgresql://user:password@host-pooler.region.neon.tech/database?sslmode=require

# Provision these in Neon before enabling authenticated application routes.
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
VITE_NEON_AUTH_URL=

# Keep this key server-only. It must never use the VITE_ prefix.
OPENROUTESERVICE_API_KEY=

# MapLibre style JSON URL. Keep the tile provider replaceable.
VITE_MAP_STYLE_URL=
