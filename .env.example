# Local PostGIS from compose.yaml. Use a pooled Neon URL in deployed environments.
DATABASE_URL=postgresql://tardis:tardis_local@127.0.0.1:5435/tardis
TEST_DATABASE_URL=postgresql://tardis:tardis_local@127.0.0.1:5435/tardis_test

# Better Auth uses the same database. Set the exact public app origin.
BETTER_AUTH_URL=http://localhost:3006
# Generate a secret of at least 32 characters (for example: openssl rand -base64 32).
BETTER_AUTH_SECRET=

# Required for email verification and password resets. Use an address on a verified Resend domain.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Tardis <hello@example.com>

# Optional OAuth providers. Configure each provider callback at
# BETTER_AUTH_URL/api/auth/callback/google or /facebook respectively.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Additional frontend origins allowed to call the API (comma separated, no paths or wildcards).
# The BETTER_AUTH_URL origin is always included. Restart after changing.
API_ALLOWED_ORIGINS=

# Keep this key server-only. It must never use the VITE_ prefix.
OPENROUTESERVICE_API_KEY=

# MapLibre style JSON URL. Keep the tile provider replaceable.
VITE_MAP_STYLE_URL=
